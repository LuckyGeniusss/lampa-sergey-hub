{
  "name": "lampa-sergey-hub",
  "version": "1.3.0",
  "description": "Sergey Online unified multi-source plugin for Lampa",
  "main": "plugin.js",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "test:static": "node tests/plugin-static.js",
    "test:backend": "node tests/backend-health.js",
    "test:discovery": "node tests/provider-discovery.js",
    "test:lampa": "node tests/real-lampa.js",
    "test:playback": "node tests/playback-smoke.js",
    "test:public": "SERGEY_PLUGIN_URL=https://luckygeniusss.github.io/lampa-sergey-hub/js node tests/real-lampa.js",
    "test:cloud:backend": "SERGEY_BACKEND=https://sergey-online-backend.onrender.com SERGEY_TIMEOUT_MS=30000 node tests/backend-health.js",
    "test:cloud:discovery": "SERGEY_BACKEND=https://sergey-online-backend.onrender.com SERGEY_TIMEOUT_MS=30000 node tests/provider-discovery.js",
    "test:cloud:playback": "SERGEY_PLUGIN_URL=https://luckygeniusss.github.io/lampa-sergey-hub/js node tests/playback-smoke.js",
    "test:cloud": "npm run test:cloud:backend && npm run test:cloud:discovery && npm run test:public && npm run test:cloud:playback",
    "test": "npm run test:static && npm run test:backend && npm run test:discovery && npm run test:lampa && npm run test:playback"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LuckyGeniusss/lampa-sergey-hub.git"
  },
  "keywords": [
    "lampa",
    "plugin",
    "online",
    "streaming"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/LuckyGeniusss/lampa-sergey-hub/issues"
  },
  "homepage": "https://github.com/LuckyGeniusss/lampa-sergey-hub#readme",
  "devDependencies": {
    "@playwright/test": "^1.63.0"
  }
}
